# =====================================================================
# OmniSentinel — .gitignore
# =====================================================================

# ── Large Data Files (DO NOT PUSH — too large for GitHub) ────────────
data/raw/
data/processed/*.parquet
data/processed/*.csv
# Numpy sequence arrays — regenerated by phase5_sequences.py (up to 968MB)
data/processed/sequences/*.npy

# ── Model Weights (large binaries — use Git LFS or DVC if needed) ────
models/*.pkl
models/*.pt
models/world_model/*.pt

# ── XGBoost JSON model (small, CAN be tracked) ───────────────────────
# models/xgb_multiclass.json   ← intentionally NOT ignored (< 1MB)

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg
.Python

# ── Virtual Environments ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter ────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS files ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Docker volumes ────────────────────────────────────────────────────
data/docker_volumes/

# ── Inference output (generated at runtime) ──────────────────────────
results/predictions/*.json

# ── Temp / scratch ────────────────────────────────────────────────────
*.tmp
*.log
scratch/

# ── Secrets ────────────────────────────────────────────────────────────
.env
*.key
secrets.yaml
